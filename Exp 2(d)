import pandas as pd
import seaborn as sns
import matplotlib.pyplot as plt
from sklearn.datasets import load_iris # Import load_iris

# Load dataset
# The original file 'iris_dataset(2d).csv' was not found.
# Replacing with the standard Iris dataset from sklearn.datasets.
iris = load_iris()
df = pd.DataFrame(data=iris.data, columns=iris.feature_names)
df['species'] = iris.target
# Map numerical target to actual species names for better readability in plots
df['species'] = df['species'].map({0: iris.target_names[0], 1: iris.target_names[1], 2: iris.target_names[2]})

# Display basic information and summary statistics
print("Basic Information:")
print(df.info())
print("\nSummary Statistics:")
print(df.describe())
# Perform univariate analysis - species count
print("\nSpecies Count:")
print(df['species'].value_counts())
# Visualize data distributions using histograms
df.hist(figsize=(8, 6), edgecolor='black')
plt.suptitle('Feature Distributions')
plt.show()
# Boxplot for Sepal Length
sns.boxplot(data=df, x='species', y='sepal length (cm)')
plt.title('Sepal Length Comparison')
plt.show()
# Pairplot to analyze feature relationships
sns.pairplot(df, hue='species')
plt.show()
