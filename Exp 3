import pandas as pd
import numpy as np
from scipy.stats import skew, kurtosis
from sklearn.datasets import load_diabetes # Import load_diabetes

# Import Datasets
# The original files were not found and caused an IndentationError.
# Replacing with a standard diabetes dataset from sklearn.datasets.
# This dataset is different from Pima Indians, so the column names will be adjusted.

data = load_diabetes()
pima_diabetes_df = pd.DataFrame(data=data.data, columns=data.feature_names)
pima_diabetes_df['target'] = data.target # Add the target variable

# For demonstration, we will use this single diabetes dataset.
# If you have specific UCI and Pima files, please upload them or provide correct paths.
uci_diabetes = pima_diabetes_df.copy() # Using the same dataset for both for demonstration
pima_diabetes = pima_diabetes_df.copy() # Adjusting for the fact that only one dataset is loaded

# Display Dataset Samples
print("UCI Diabetes Dataset Sample:")
print(uci_diabetes.head())
print("\nPima Indians Diabetes Dataset Sample:")
print(pima_diabetes.head())

# Define Relevant Numerical Columns
# Adjusting column names to match the sklearn diabetes dataset
numerical_columns = ["age", "sex", "bmi", "bp", "s1", "s2", "s3", "s4", "s5", "s6", "target"]

# Univariate Analysis Function
def univariate_analysis(df, columns):
    stats = {}
    for col in columns:
        if col in df.columns and pd.api.types.is_numeric_dtype(df[col]):
            stats[col] = {
                "Mean": np.mean(df[col]),
                "Median": np.median(df[col]),
                "Mode": df[col].mode()[0] if not df[col].mode().empty else np.nan,
                "Variance": np.var(df[col], ddof=1),
                "Standard Deviation": np.std(df[col], ddof=1),
                "Skewness": skew(df[col]),
                "Kurtosis": kurtosis(df[col])
            }
        else:
            print(f"Skipping non-numeric or missing column: {col}")
    return pd.DataFrame(stats).T

# Perform Univariate Analysis
uci_stats = univariate_analysis(uci_diabetes, numerical_columns)
pima_stats = univariate_analysis(pima_diabetes, numerical_columns)

# Display Results
print("\nUCI Diabetes Dataset Statistics:")
print(uci_stats)
print("\nPima Indians Diabetes Dataset Statistics:")
print(pima_stats)
