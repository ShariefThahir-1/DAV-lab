# Import Libraries
import pandas as pd
import numpy as np
import seaborn as sns
import matplotlib.pyplot as plt
from sklearn.model_selection import train_test_split
from sklearn.linear_model import LinearRegression, LogisticRegression
from sklearn.metrics import r2_score, accuracy_score
from sklearn.datasets import load_diabetes # Import load_diabetes

# Load the Datasets
# Using try-except for FileNotFoundError and falling back to sklearn.datasets if local files are not found.
try:
    uci_diabetes = pd.read_csv("uci_diabetes (3).csv")
except FileNotFoundError:
    print("Warning: 'uci_diabetes (3).csv' not found. Loading sklearn diabetes dataset.")
    data = load_diabetes()
    uci_diabetes = pd.DataFrame(data=data.data, columns=data.feature_names)
    uci_diabetes['target'] = data.target # Add the continuous target
    # Create a binary outcome for logistic regression
    uci_diabetes['diabetes_outcome'] = (uci_diabetes['target'] > uci_diabetes['target'].median()).astype(int)

try:
    pima_diabetes = pd.read_csv("pima_diabetes (3).csv")
except FileNotFoundError:
    print("Warning: 'pima_diabetes (3).csv' not found. Loading sklearn diabetes dataset.")
    data = load_diabetes()
    pima_diabetes = pd.DataFrame(data=data.data, columns=data.feature_names)
    pima_diabetes['target'] = data.target # Add the continuous target
    # Create a binary outcome for logistic regression
    pima_diabetes['diabetes_outcome'] = (pima_diabetes['target'] > pima_diabetes['target'].median()).astype(int)

# Display first few rows
print("UCI Diabetes Dataset Sample:\n", uci_diabetes.head())
print("\nPima Indians Diabetes Dataset Sample:\n", pima_diabetes.head())

# Perform Linear Regression (Predicting 'target' using 'bmi')
def linear_regression_analysis(df, x_column, y_column):
    if df.empty or x_column not in df.columns or y_column not in df.columns:
        print(f"\nSkipping linear regression: DataFrame is empty or missing '{x_column}' or '{y_column}'.")
        return

    X = df[[x_column]] # Independent variable
    Y = df[y_column]   # Dependent variable

    model = LinearRegression()
    model.fit(X, Y)
    Y_pred = model.predict(X)

    r2 = r2_score(Y, Y_pred)

    print(f"\nLinear Regression (Predicting {y_column} using {x_column}):")
    print(f"R2 Score: {r2:.4f}")

    # Plot
    plt.figure(figsize=(8, 6))
    plt.scatter(X, Y, color='blue', label='Actual Data')
    plt.plot(X, Y_pred, color='red', linewidth=2, label='Regression Line')
    plt.xlabel(x_column)
    plt.ylabel(y_column)
    plt.title(f"Linear Regression: {x_column} vs. {y_column}")
    plt.legend()
    plt.show()

# Apply Linear Regression on both datasets (using 'bmi' to predict 'target')
linear_regression_analysis(uci_diabetes, "bmi", "target")
linear_regression_analysis(pima_diabetes, "bmi", "target")

# Perform Logistic Regression (Predicting Diabetes outcome)
def logistic_regression_analysis(df, features, target):
    # Check if target column exists and has at least two unique values for classification
    if df.empty or target not in df.columns or len(df[target].unique()) < 2:
        print(f"\nSkipping logistic regression: DataFrame is empty, missing '{target}' or target is not binary/sufficient.")
        return
    
    # Check if all feature columns exist
    if not all(col in df.columns for col in features):
        missing_features = [col for col in features if col not in df.columns]
        print(f"\nSkipping logistic regression: Missing features in DataFrame: {missing_features}")
        return

    X = df[features]
    Y = df[target]

    # Splitting dataset
    X_train, X_test, Y_train, Y_test = train_test_split(X, Y, test_size=0.2, random_state=42)
    
    # Suppress convergence warning for LogisticRegression by increasing max_iter
    model = LogisticRegression(max_iter=1000)
    model.fit(X_train, Y_train)
    Y_pred = model.predict(X_test)
    accuracy = accuracy_score(Y_test, Y_pred)

    print(f"\nLogistic Regression (Predicting {target} using {features}):")
    print(f"Accuracy Score: {accuracy:.4f}")

# Select features and target for the sklearn diabetes dataset
# Using 'diabetes_outcome' which was created as a binary target
features_lr = ["bmi", "bp", "age", "s5"]
target_lr = "diabetes_outcome"

# Apply Logistic Regression on both datasets
logistic_regression_analysis(uci_diabetes, features_lr, target_lr)
logistic_regression_analysis(pima_diabetes, features_lr, target_lr)
